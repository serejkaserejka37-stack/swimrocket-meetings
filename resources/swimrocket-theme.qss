/* SwimRocket Light Glass — светлые полупрозрачные панели в стилистике iOS */

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #EDF4FF, stop:0.52 #F7F9FD, stop:1 #FFF1E9);
    color: #242841;
}
QDialog, QMessageBox {
    background-color: #F3F6FB;
    color: #242841;
}
QWidget {
    background-color: transparent;
    color: #242841;
    font-family: "Segoe UI", "SF Pro Display", sans-serif;
    font-size: 10pt;
}
QMenuBar {
    background-color: rgba(255, 255, 255, 145);
    color: #475467;
    border-bottom: 1px solid rgba(255, 255, 255, 190);
    padding: 4px 10px;
}
QMenuBar::item { padding: 5px 10px; border-radius: 7px; }
QMenuBar::item:selected { background-color: rgba(241, 100, 46, 24); color: #F1642E; }
QMenu {
    background-color: rgba(255, 255, 255, 245);
    color: #242841;
    border: 1px solid #DDE5F0;
    border-radius: 12px;
    padding: 6px;
}
QMenu::item { padding: 7px 22px; border-radius: 7px; }
QMenu::item:selected { background-color: #FFF0E9; color: #F1642E; }

QWidget#leftPanel, QWidget#rightPanel {
    background-color: rgba(255, 255, 255, 220);
    border: 1px solid rgba(255, 255, 255, 245);
    border-radius: 20px;
}
QFrame#brandHeader {
    background-color: rgba(255, 255, 255, 225);
    border: 1px solid rgba(255, 255, 255, 248);
    border-radius: 20px;
}
QLabel { background: transparent; color: #242841; }
QLabel#brandTitle {
    color: #F1642E;
    font-family: "BebasNeueCyrillic", "Arial Narrow", sans-serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 2px;
}
QLabel#brandSubtitle { color: #667085; font-size: 11px; }
QLabel#serverBadge {
    color: #344054;
    background-color: rgba(255, 255, 255, 210);
    border: 1px solid #DDE5F0;
    border-radius: 12px;
    padding: 9px 14px;
    font-size: 10px;
    font-weight: 600;
}
QLabel#timerLabel {
    color: #242841;
    font-size: 18px;
    font-weight: 700;
    font-family: "SF Mono", "Consolas", monospace;
}
QLabel#recordingIndicator { color: #F1642E; font-size: 16px; font-weight: bold; }
QLabel#sectionHeader { color: #F1642E; font-size: 14px; font-weight: 700; padding: 4px 0; }
QLabel#recordingName { color: #242841; font-size: 17px; font-weight: 700; }
QLabel#recordingInfo { color: #667085; font-size: 12px; }

QPushButton {
    background-color: rgba(255, 255, 255, 205);
    color: #344054;
    border: 1px solid #D9E2EF;
    border-radius: 11px;
    padding: 8px 10px;
    font-weight: 600;
    min-height: 20px;
}
QPushButton:hover { background-color: #FFFFFF; border-color: #B8C6DA; }
QPushButton:pressed { background-color: #EDF2F8; }
QPushButton:disabled { background-color: rgba(240, 243, 248, 180); color: #98A2B3; border-color: #E8EDF4; }
QPushButton#recordButton {
    background-color: #F1642E;
    color: #FFFFFF;
    border: none;
    border-radius: 13px;
    padding: 5px 6px;
    min-height: 29px;
    font-weight: 700;
}
QPushButton#recordButton:hover { background-color: #FF7542; }
QPushButton#pauseButton {
    background-color: #FDE676;
    color: #242841;
    border: none;
    border-radius: 13px;
    padding: 5px 6px;
    min-height: 29px;
}
QPushButton#pauseButton:hover { background-color: #FFECA0; }
QPushButton#stopButton {
    background-color: #242841;
    color: #FFFFFF;
    border: none;
    border-radius: 13px;
    padding: 5px 6px;
    min-height: 29px;
}
QPushButton#stopButton:hover { background-color: #353A59; }
QPushButton#muteButton, QPushButton#testMicButton { padding: 5px 8px; }
QPushButton#recordButton:disabled, QPushButton#pauseButton:disabled, QPushButton#stopButton:disabled {
    background-color: #E7ECF3;
    color: #98A2B3;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(255, 255, 255, 192);
    color: #242841;
    border: 1px solid #D9E2EF;
    border-radius: 11px;
    padding: 7px 11px;
    min-height: 22px;
    selection-background-color: #FFD8C8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #F1642E; background-color: #FFFFFF; }
QLineEdit#meetingNameInput, QLineEdit#meetingParticipantsInput {
    background-color: rgba(255, 255, 255, 185);
    border: 1px solid rgba(217, 226, 239, 210);
    border-radius: 12px;
    padding: 9px 12px;
}
QComboBox::drop-down { border: none; width: 25px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #242841;
    border: 1px solid #D9E2EF;
    selection-background-color: #FFF0E9;
    selection-color: #F1642E;
}
QComboBox QAbstractItemView::item { padding: 5px 8px; min-height: 20px; }
QSpinBox::up-button, QSpinBox::down-button { background: transparent; width: 18px; }
QSpinBox::up-arrow { image: url(resources/arrow_up.png); width: 8px; height: 8px; }
QSpinBox::down-arrow { image: url(resources/arrow_down.png); width: 8px; height: 8px; }

QTextEdit, QPlainTextEdit, QListWidget {
    background-color: rgba(255, 255, 255, 178);
    color: #242841;
    border: 1px solid rgba(217, 226, 239, 210);
    border-radius: 13px;
    padding: 8px;
    selection-background-color: #FFD8C8;
    selection-color: #242841;
}
QListWidget::item { padding: 5px 8px; border-radius: 8px; margin: 2px; }
QListWidget::item:selected { background-color: #FFF0E9; color: #F1642E; }
QListWidget::item:hover { background-color: rgba(241, 100, 46, 16); }

QTabWidget::pane { background: transparent; border: none; }
QTabBar::tab {
    background-color: transparent;
    color: #667085;
    border: 1px solid transparent;
    padding: 9px 17px;
    margin-right: 4px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
}
QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 215);
    color: #F1642E;
    border-color: #D9E2EF;
    border-bottom: 2px solid #F1642E;
}
QTabBar::tab:hover { background-color: rgba(255, 255, 255, 120); color: #242841; }

QFrame#collapsibleHeader {
    background-color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(217, 226, 239, 180);
    border-radius: 10px;
}
QRadioButton#captureMode {
    background-color: rgba(255, 255, 255, 135);
    border: 1px solid #D9E2EF;
    border-radius: 10px;
    padding: 5px 8px;
    font-weight: 600;
    font-size: 12px;
    spacing: 6px;
}
QRadioButton#captureMode:checked { border-color: #F1642E; color: #F1642E; background-color: #FFF4EF; }
QRadioButton::indicator, QCheckBox::indicator {
    width: 17px; height: 17px; border-radius: 6px;
    border: 1px solid #B8C6DA; background-color: #FFFFFF;
}
QRadioButton::indicator { border-radius: 9px; }
QRadioButton::indicator:checked, QCheckBox::indicator:checked { background-color: #F1642E; border-color: #F1642E; }
QCheckBox { color: #344054; spacing: 8px; }

QGroupBox {
    background-color: rgba(255, 255, 255, 215);
    border: 1px solid #D9E2EF;
    border-radius: 14px;
    margin-top: 16px;
    padding-top: 22px;
    font-weight: 700;
    color: #F1642E;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    top: 5px;
    padding: 0 7px;
    background-color: #F3F6FB;
}
QProgressBar {
    background-color: #E7ECF3;
    border: none;
    border-radius: 8px;
    text-align: center;
    color: #242841;
    min-height: 18px;
}
QProgressBar::chunk { background-color: #F1642E; border-radius: 8px; }
QStatusBar { background-color: rgba(255, 255, 255, 130); color: #667085; border-top: 1px solid #E4EAF2; }
QSplitter::handle { background-color: transparent; width: 8px; height: 8px; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background-color: #C3CEDD; min-height: 30px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background-color: #9EACC0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; }
QScrollBar::handle:horizontal { background-color: #C3CEDD; min-width: 30px; border-radius: 5px; }
QToolTip { background-color: #FFFFFF; color: #242841; border: 1px solid #D9E2EF; border-radius: 8px; padding: 6px 9px; }

#statusRow { background-color: rgba(255, 255, 255, 150); border: 1px solid #D9E2EF; border-radius: 11px; }
#statusName { color: #242841; font-size: 13px; }
#statusMessage, #statusAction { color: #667085; font-size: 12px; }
#renameButton { padding: 5px 12px; font-size: 12px; min-height: 16px; }
#speakerPanelToggle { color: #F1642E; background: transparent; border: none; font-weight: 700; text-align: left; }
#wizardHeader { color: #242841; font-size: 19px; font-weight: 700; }
#wizardStep { background-color: rgba(255, 255, 255, 160); border: 1px solid #D9E2EF; border-radius: 13px; }
#wizardStepNumber { background-color: #F1642E; color: #FFFFFF; border-radius: 15px; }
#wizardStepTitle { color: #242841; font-weight: 700; }
#wizardStepDesc { color: #667085; }
#wizardSaveBtn { background-color: #F1642E; color: #FFFFFF; border: none; }

#leftPanel, #leftPanel QLabel, #leftPanel QRadioButton, #leftPanel QCheckBox,
#leftPanel QPushButton, #leftPanel QListWidget, #leftPanel QComboBox, #leftPanel QToolButton { font-size: 9pt; }
#leftPanel #timerLabel { font-size: 14pt; }
